{
  "name": "orientsol-web",
  "private": true,
  "version": "4.0.9",
  "description": "OrientSol 4.0 - Software Avanzado de Cálculo Solar Fotovoltaico y Térmico",
  "author": "OrientSol Team",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-pyodide && tsc && vite build",
    "preview": "vite preview",
    "prepare-pyodide": "node scripts/copy-pyodide.js",
    "electron:start": "electron .",
    "electron:test": "electron scripts/test-electron-full.mjs",
    "app:dev": "vite build && electron .",
    "app:desktop": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win --x64",
    "pack:win": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "build:all": "npm run build && electron-builder -mwl",
    "cap:sync": "npm run build && cap sync android",
    "cap:open:android": "cap open android",
    "build:apk": "npm run build && cap sync android && node scripts/build-android-apk.mjs",
    "build:offline": "npm run build && npm run cap:sync && electron-builder --win --x64",
    "deploy": "npm run build && gh-pages -d dist --no-history"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/emscripten": "^1.41.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "pyodide": "^314.0.7",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.orientsol.app",
    "productName": "OrientSol 4.0",
    "copyright": "Copyright © 2026 OrientSol",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
